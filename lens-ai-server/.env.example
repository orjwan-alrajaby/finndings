# Copy to .env. Never commit the real file.
# A free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LENS_AI_PROVIDER=gemini      # or mock (the default when no key is set)
# LENS_AI_MODEL=gemini-3.8-flash
# LENS_AI_FALLBACK_MODEL=gemini-2.5-flash   # tried on 503/429; "none" to disable
# LENS_AI_PORT=8787
# LENS_AI_ALLOWED_ORIGINS=chrome-extension://<your-extension-id>
# LENS_AI_DEBUG=1
